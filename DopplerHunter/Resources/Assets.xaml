<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--BRUSHES-->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#888888" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#555555" />
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="Transparent" />

    <!--STYLES-->
    <Style x:Key="ScrollBarThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                     <!--Aquí definimos el grosor visual con el Margin--> 
                    <Border x:Name="rectangle" 
                        Background="{StaticResource ScrollBarThumbBrush}" 
                        CornerRadius="4" 
                        Margin="2,0,2,0"
                            />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="rectangle" Property="Background" Value="{StaticResource ScrollBarThumbHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
        <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
        <Setter Property="Background" Value="{StaticResource ScrollBarTrackBrush}"/>
        <Setter Property="Width" Value="8"/>
        <!-- Grosor de la barra vertical -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                        <!-- El Track es el corazón de la barra [10, 11] -->
                        <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- Soporte para ScrollBar Horizontal [12] -->
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                <Track x:Name="PART_Track" IsEnabled="{TemplateBinding IsEnabled}">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBarThumbStyle}" Margin="0,2,0,2"/>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--ICONS-->
    <GeometryGroup x:Key="SunIconGeometry">
        <!-- Círculo central -->
        <EllipseGeometry Center="50,50" RadiusX="25" RadiusY="25" />
        <!-- Rayos -->
        <LineGeometry StartPoint="50,0" EndPoint="50,20" />
        <LineGeometry StartPoint="50,80" EndPoint="50,100" />
        <LineGeometry StartPoint="0,50" EndPoint="20,50" />
        <LineGeometry StartPoint="80,50" EndPoint="100,50" />
    </GeometryGroup>
