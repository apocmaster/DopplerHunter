<Window x:Class="DopplerHunter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DopplerHunter.ViewModels"
        
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        Title="Doopple Hunter" Height="620" Width="1140">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header Top Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Grid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR / TITULO -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="QUICK DUPLICATE FINDER" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <!-- CONTENIDO PRINCIPAL EN 3 COLUMNAS -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Columna 1: Sources (Treeview) -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <!-- Columna 2: Selected Paths -->
                <!--<ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>-->
                <!-- Columna 3: Analysis & Actions -->
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ========================================== -->
                <!-- ROW 1: SOURCES -->
                <!-- ========================================== -->
                <Border Grid.Row="0" >
                    <DockPanel >
                        <TextBlock DockPanel.Dock="Top" Text="SOURCES" Style="{StaticResource SectionHeaderStyle}"/>
                        <Border Style="{StaticResource CardPanelStyle}">
                            <TreeView BorderThickness="0" Background="Transparent" ItemsSource="{Binding Drives}" 
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Imagen o icono puede ir aquí [14] -->
                                            <Path x:Name="DiskOrFolderIcon" Data="{StaticResource FolderGeometry }" StrokeThickness="1" Width="20" Height="20" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Name}" Margin="5,0"/>
                                        </StackPanel>
                                        <HierarchicalDataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDrive}" Value="True">
                                                <Setter TargetName="DiskOrFolderIcon" Property="Data" Value="{StaticResource HardDiskGeometry}"/>
                                                <Setter TargetName="DiskOrFolderIcon" Property="Stroke" Value="#FF232321"/>
                                                <Setter TargetName="DiskOrFolderIcon" Property="Fill" Value="#FFE7E6E6"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDrive}" Value="False">
                                                <Setter TargetName="DiskOrFolderIcon" Property="Data" Value="{StaticResource FolderGeometry}"/>
                                                <Setter TargetName="DiskOrFolderIcon" Property="Stroke" Value="#FF745118"/>
                                                <Setter TargetName="DiskOrFolderIcon" Property="Fill" Value="#FFFAD67F"/>
                                            </DataTrigger>
                                        </HierarchicalDataTemplate.Triggers>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                                <TreeView.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" 
                        Command="{Binding ToggleExpandCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TreeView}, Path=SelectedItem}"/>
                                    <KeyBinding Key="Enter" 
                        Command="{Binding AddFolderToSearchCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TreeView}, Path=SelectedItem}"/>
                                </TreeView.InputBindings>
                            </TreeView>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- ========================================== -->
                <!-- ROW 2: SELECTED PATHS -->
                <!-- ========================================== -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock  Text="SELECTED PATHS" Style="{StaticResource SectionHeaderStyle}"/>

                        <!-- Controles Globales Superior -->
                        <Border Style="{StaticResource CardPanelStyle}" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="GLOBAL CONTROLS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,4"
                            Command="{Binding ClearSelectionCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource ClearSelectionGeometry}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,4,0"  Stroke="{StaticResource TextSecondary}"/>
                                            <TextBlock Text="Clear"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,4"
                            Command="{Binding SearchDuplicatesCommand}">
                                        <StackPanel  Orientation="Horizontal">
                                            <Path Data="{StaticResource DuplicateGeometry}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,4,0"  Stroke="{StaticResource AppBackground}"/>
                                            <TextBlock Text="Search Duplicates" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FoldersToSearch}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardPanelStyle}" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding FullPath}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,8"/>
                                            <DockPanel Grid.Row="2">
                                                <CheckBox Content="Scan Subdirectories" IsChecked="{Binding IncludeSubdirectories, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <Button  
                                    Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Foreground="{StaticResource DangerAccent}" 
                                    HorizontalAlignment="Right" Background="Transparent" 
                                    BorderThickness="0" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource TrashGeometry}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,4,0"  Stroke="{StaticResource DangerAccent}"/>
                                                        <TextBlock Text="Remove"/>
                                                    </StackPanel>
                                                </Button>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ========================================== -->
                <!-- ROWS: BARRAS -->
                <!-- ========================================== -->
                <Border Grid.Row="1" BorderBrush="{StaticResource Bar}" 
                    BorderThickness="1" Height="2" VerticalAlignment="Stretch">
                </Border>
            </Grid>

            


            <!-- ========================================== -->
            <!-- COLUMNA 3: ANALYSIS & ACTION -->
            <!-- ========================================== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ANALYSIS &amp; ACTION" Style="{StaticResource SectionHeaderStyle}"/>

                <!-- Tarjetas de Métricas/Métricas clave (KPIs) -->
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
                    <Border Style="{StaticResource CardPanelStyle}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Directories Scanned" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding TotalFoldersFound}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanelStyle}" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="Total Files" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding TotalFilesFound}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanelStyle}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Duplicates Found" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding TotalDuplicatesFound}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerAccent}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Tabla de Resultados (DataGrid de Archivos Duplicados) -->
                <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}" Padding="12">
                    <DockPanel>
                        <!-- Filtros y Acción Masiva -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <ComboBox Width="100" SelectedIndex="0" Margin="0,0,8,0">
                                    <ComboBoxItem Content="Filter All"/>
                                </ComboBox>
                                <ComboBox Width="120" SelectedIndex="0">
                                    <ComboBoxItem Content="All Duplicates"/>
                                </ComboBox>
                            </StackPanel>
                            <Button Content="DELETE ALL SELECTED DUPLICATES" Style="{StaticResource PrimaryButtonStyle}" Background="{StaticResource DangerAccent}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Tabla con agrupamiento de duplicados -->
                        <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" 
                                  GridLinesVisibility="Horizontal" 
                                  HorizontalGridLinesBrush="{StaticResource BorderBrushLight}" 
                                  Background="Transparent" BorderThickness="0"
                                  ItemsSource="{Binding FilesView}" 
                                  CanUserSortColumns="True"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  >
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Width="40"/>
                                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="150"/>
                                <DataGridTextColumn Header="Ext" Binding="{Binding Extension}" Width="SizeToCells"/>
                                <DataGridTextColumn Header="Hash" Binding="{Binding FileHash}" Width="50"/>
                                <DataGridTextColumn Header="Parent Folder" Binding="{Binding FolderPath}" Width="140"/>
                                <DataGridTemplateColumn Header="Actions" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="DELETE" Foreground="{StaticResource DangerAccent}" Background="Transparent" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
            <!-- ========================================== -->
            <!-- COLUMNAS: BARRAS -->
            <!-- ========================================== -->
            <Border Grid.Column="1" BorderBrush="{StaticResource Bar}" 
                BorderThickness="1" Width="2" VerticalAlignment="Stretch">
            </Border>
        </Grid>
    </Grid>
</Window>
