<Window x:Class="DopplerHunter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DopplerHunter.ViewModels"
        xmlns:converters="clr-namespace:DopplerHunter.Converters"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        Title="Doopple Hunter" Height="620" Width="1140">
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header Top Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Grid -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR / TITULO -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="QUICK DUPLICATE FINDER" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,4"
                    Command="{Binding ScanForDuplicatesCommand}">
                <StackPanel  Orientation="Horizontal">
                    <Path Data="{StaticResource DuplicateGeometry}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,4,0"  Stroke="{StaticResource AppBackground}"/>
                    <TextBlock Text="Search Duplicates" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- CONTENIDO PRINCIPAL EN 3 COLUMNAS -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ========================================== -->
                <!-- ROW 1: SOURCES -->
                <!-- ========================================== -->
                <Border Grid.Row="0" >
                    <DockPanel >
                        <TextBlock DockPanel.Dock="Top" Text="SOURCES" Style="{StaticResource SectionHeaderStyle}"/>
                        <Border Style="{StaticResource CardPanelStyle}">
                            <TreeView BorderThickness="0" Background="Transparent" ItemsSource="{Binding Drives}" 
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Imagen o icono puede ir aquí [14] -->
                                            <Path x:Name="DiskOrFolderIcon" Data="{StaticResource FolderGeometry }" StrokeThickness="1" Width="20" Height="20" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Name}" Margin="5,0"/>
                                        </StackPanel>
                                        <HierarchicalDataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDrive}" Value="True">
                                                <Setter TargetName="DiskOrFolderIcon" Property="Data" Value="{StaticResource HardDiskGeometry}"/>
                                                <Setter TargetName="DiskOrFolderIcon" Property="Stroke" Value="#FF232321"/>
                                                <Setter TargetName="DiskOrFolderIcon" Property="Fill" Value="#FFE7E6E6"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDrive}" Value="False">
                                                <Setter TargetName="DiskOrFolderIcon" Property="Data" Value="{StaticResource FolderGeometry}"/>
                                                <Setter TargetName="DiskOrFolderIcon" Property="Stroke" Value="#FF745118"/>
                                                <Setter TargetName="DiskOrFolderIcon" Property="Fill" Value="#FFFAD67F"/>
                                            </DataTrigger>
                                        </HierarchicalDataTemplate.Triggers>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                                <TreeView.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick" 
                        Command="{Binding ToggleExpandCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TreeView}, Path=SelectedItem}"/>
                                    <KeyBinding Key="Enter" 
                        Command="{Binding SelectFolderForSearchCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=TreeView}, Path=SelectedItem}"/>
                                </TreeView.InputBindings>
                            </TreeView>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- ========================================== -->
                <!-- ROW 2: SELECTED PATHS -->
                <!-- ========================================== -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding SelectedSearchFolders.Count, StringFormat='SELECTED PATHS: ({0})'}" Style="{StaticResource SectionHeaderStyle}"/>
                            <TextBlock Grid.Column="1" TextAlignment="Right">
                                <Hyperlink Command="{Binding ClearFoldersFromSearchCommand}" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource ClearSelectionGeometry}" 
                                              Width="15" 
                                              Height="15" 
                                              Stretch="Uniform" 
                                              Margin="0,0,4,0"
                                              Stroke="{Binding Foreground, ElementName=ClearAll}" />
                                        <TextBlock x:Name="ClearAll" Text="Clear All"/>
                                    </StackPanel>
                                </Hyperlink>
                            </TextBlock>
                        </Grid>                        
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedSearchFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardPanelStyle}" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding FullPath}" FontSize="11" 
                                                       Foreground="{StaticResource TextSecondary}" 
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="14" 
                                                       FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,8"/>
                                            <DockPanel Grid.Row="2">
                                                <CheckBox Content="Scan Subdirectories" IsChecked="{Binding IncludeSubdirectories, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                <Button  
                                    Command="{Binding DataContext.ExcludeFolderFromSearchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Foreground="{StaticResource DangerAccent}" 
                                    HorizontalAlignment="Right" Background="Transparent" 
                                    BorderThickness="0" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource TrashGeometry}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,4,0"  Stroke="{StaticResource DangerAccent}"/>
                                                        <TextBlock Text="Remove"/>
                                                    </StackPanel>
                                                </Button>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ========================================== -->
                <!-- ROWS: BARRAS -->
                <!-- ========================================== -->
                <Border Grid.Row="1" BorderBrush="{StaticResource Bar}" 
                    BorderThickness="1" Height="2" VerticalAlignment="Stretch">
                </Border>
            </Grid>




            <!-- ========================================== -->
            <!-- COLUMNA 3: ANALYSIS & ACTION -->
            <!-- ========================================== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="ANALYSIS &amp; ACTION" Style="{StaticResource SectionHeaderStyle}"/>

                <!-- Tarjetas de Métricas/Métricas clave (KPIs) -->
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
                    <Border Style="{StaticResource CardPanelStyle}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="Directories Scanned" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding TotalFoldersFound}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanelStyle}" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="Total Files" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding TotalFilesFound}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardPanelStyle}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Duplicates Found" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                            <TextBlock Text="{Binding TotalDuplicatesFound}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerAccent}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Tabla de Resultados (DataGrid de Archivos Duplicados) -->
                <Border Grid.Row="2" Style="{StaticResource CardPanelStyle}" Padding="12">
                    <DockPanel>
                        <!-- Filtros y Acción Masiva -->
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" >
                                <ComboBox Width="100" SelectedIndex="0" Margin="0,0,8,0">
                                    <ComboBoxItem Content="Filter All"/>
                                </ComboBox>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,4,0" >Show dups</TextBlock>
                                <ToggleButton Width="50" Height="25">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid>
                                                <!-- Fondo cápsula -->
                                                <Border x:Name="SwitchBackground"
                                                    CornerRadius="12"
                                                    Background="LightGray"/>
                                                <!-- Thumb circular -->
                                                <Ellipse x:Name="SwitchThumb"
                                                     Width="20" Height="20"
                                                     Fill="White"
                                                     HorizontalAlignment="Left"
                                                     Margin="2,0,0,0"/> 
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="SwitchBackground" Property="Background" Value="DodgerBlue"/>
                                                    <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,2,0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </StackPanel>
                            <Button Content="DELETE ALL SELECTED DUPLICATES" Style="{StaticResource DangerButtonStyle}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Tabla con agrupamiento de duplicados -->
                        <DataGrid AutoGenerateColumns="False" 
                                  HeadersVisibility="Column" 
                                  GridLinesVisibility="Horizontal" 
                                  HorizontalGridLinesBrush="{StaticResource BorderBrushLight}" 
                                  Background="Transparent" BorderThickness="0"
                                  ItemsSource="{Binding FilesFoundView}" 
                                  CanUserSortColumns="True"
                                  CanUserAddRows="False"                                  
                                  FrozenColumnCount="0"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"                                  
                                  ColumnHeaderHeight="32"
                                  
                                  >
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.Panel>
                                        <ItemsPanelTemplate>
                                            <DataGridRowsPresenter />
                                        </ItemsPanelTemplate>
                                    </GroupStyle.Panel>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6" CornerRadius="4" Margin="0,4" BorderThickness="1" Background="#FFF2F3F5" >
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📁 Group Hash: " FontWeight="Bold" Foreground="#334155"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource PrimaryAccent}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding ItemCount, StringFormat=' ({0} files)'}" Foreground="#64748B" Margin="8,0,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>                            
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Width="40" IsReadOnly="False"/>
                                <DataGridTextColumn Header="Dup N°" Binding="{Binding DuplicateIndex}" Width="SizeToCells" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="File Name" Width="SizeToCells" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Hyperlink Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding FullPath}"
                                                           ToolTip="{Binding ToolTipName}">
                                                   
                                                    <TextBlock Text="{Binding DisplayName}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Hyperlink>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ext" Binding="{Binding Extension}" Width="SizeToCells" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding FileSizeFormatted}" Width="Auto" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Dup" Width="40" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Path Data="{StaticResource FilesDuplicatedGeometry}"
                                                  
                                                  Visibility="{Binding IsFileDuplicated, Converter={StaticResource BoolToVisibilityConverter}}"
                                                  Stroke="{StaticResource TextPrimary}"
                                                  StrokeThickness="1" Width="20" Height="20" Stretch="Uniform"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>                                
                                <DataGridTextColumn Header="Parent Folder" Binding="{Binding FolderPath}" Width="140" IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="Actions" Width="80" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="DELETE" Foreground="{StaticResource DangerAccent}" Background="Transparent" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
            <!-- ========================================== -->
            <!-- COLUMNAS: BARRAS -->
            <!-- ========================================== -->
            <Border Grid.Column="1" BorderBrush="{StaticResource Bar}" 
                BorderThickness="1" Width="2" VerticalAlignment="Stretch">
            </Border>
        </Grid>
    </Grid>
</Window>
