<UserControl x:Class="DopplerHunter.Views.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DopplerHunter.Views.Controls"
             mc:Ignorable="d"
             x:Name="root"
             d:DataContext="{d:DesignInstance Type=local:PageHeader}"
    d:DesignWidth="300" d:DesignHeight="40">
    <StackPanel Orientation="Horizontal">
        <TextBlock 
            Text="{Binding IconString,
RelativeSource={RelativeSource AncestorType=local:PageHeader}}" 
            FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock 
            Text="{Binding Title,
RelativeSource={RelativeSource AncestorType=local:PageHeader}}" 
            FontWeight="Bold" FontSize="14" 
            Foreground="{StaticResource TextPrimary}" 
            VerticalAlignment="Center"
            d:Text="Page Title"
            />        
    </StackPanel>
</UserControl>
